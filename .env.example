# Example .env for zzzzza bot (Playwright + Edge focused)

# Telegram
API_ID=123456
API_HASH=your_api_hash
SESSION_NAME=session_bot

# Playwright / Edge
PLAYWRIGHT_CHANNEL=msedge
EDGE_EXECUTABLE_PATH=  # optional, path to msedge executable
EDGE_USER_DATA_DIR=browser_profiles/bot_profile
HEADLESS_MODE=False
PLAYWRIGHT_LAUNCH_ARGS=--no-sandbox --disable-blink-features=AutomationControlled

# Database
DATABASE_PATH=data/code_history.db
DB_VACUUM_INTERVAL=86400
DB_DEDUP_RETENTION=2592000
DB_LOG_RETENTION=604800

# OCR / validation
OCR_CONFIDENCE_THRESHOLD=0.70
MIN_ENTROPY=2.3
UPPERCASE_MIN_ENTROPY=2.9

# Rate limiting
RATE_LIMIT_STRATEGY=sliding_window
RATE_LIMIT_WINDOW=60
RATE_LIMIT_MAX_REQUESTS=30
MIN_DELAY_BETWEEN_SUBMITS=0.5

# Retry
RETRY_STRATEGY=exponential_backoff
MAX_RETRY_ATTEMPTS=2
RETRY_BASE_DELAY=2.0
RETRY_MAX_DELAY=30.0
RETRY_BACKOFF_FACTOR=1.5

# Monitoring
ENABLE_HEARTBEAT=True
HEARTBEAT_INTERVAL=300
ENABLE_TELEGRAM_ALERTS=True
QUALITY_ALERT_THRESHOLD=0.60

# Debug
ENABLE_DEBUG_LOGS=False
LOG_LEVEL=INFO
LOG_FILE=logs/bot_activity.log
